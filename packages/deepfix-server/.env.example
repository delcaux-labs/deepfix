DEEPFIX_LLM_API_KEY=
DEEPFIX_LLM_BASE_URL=https://openrouter.ai/api/v1
DEEPFIX_LLM_MODEL_NAME=openai/x-ai/grok-4-fast
DEEPFIX_LLM_TEMPERATURE=0.7
DEEPFIX_LLM_MAX_TOKENS=8000
DEEPFIX_LLM_CACHE=1
DEEPFIX_LLM_TRACK_USAGE=1


DEEPFIX_SERVER_DATABASE_URL=sqlite:///./deepfix_server.db

MLFLOW_TRACKING_URI=
MLFLOW_EXP_NAME=Deepfix-server

# OpenHands Autonomous Fix
OPENHANDS_LLM_API_KEY=
OPENHANDS_LLM_MODEL=openai/deepseek/deepseek-v4-flash-0731
OPENHANDS_LLM_BASE_URL=https://api.tensorix.ai/v1
OPENHANDS_DOCKER_IMAGE=ghcr.io/openhands/agent-server:latest-python
OPENHANDS_SANDBOX_PORT=8010
OPENHANDS_USE_LOCAL_SERVER=true
OPENHANDS_SERVER_URL=http://localhost:60000

# OpenTelemetry / MLflow Tracing for OpenHands
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5000
OTEL_EXPORTER_OTLP_HEADERS="x-mlflow-experiment-id=123"  # Replace "123" with your MLflow experiment ID
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
