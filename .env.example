DEEPFIX_LLM_API_KEY=
DEEPFIX_LLM_BASE_URL=https://openrouter.ai/api/v1
DEEPFIX_LLM_MODEL_NAME=openai/x-ai/grok-4.1-fast
DEEPFIX_LLM_TEMPERATURE=0.7
DEEPFIX_LLM_MAX_TOKENS=8000
DEEPFIX_LLM_CACHE=1
DEEPFIX_LLM_TRACK_USAGE=1

# Embedder Settings (OpenAI-compatible)
DEEPFIX_EMBEDDER_API_KEY=
DEEPFIX_EMBEDDER_BASE_URL=https://api.openai.com/v1
DEEPFIX_EMBEDDER_MODEL_NAME=text-embedding-3-small
DEEPFIX_EMBEDDER_DIMENSIONS=1536


FRONTEND_URL=

# LLM tracing with mlfow
MLFLOW_TRACKING_URI=
MLFLOW_EXP_NAME=Deepfix-server

TAVILY_API_KEY=
OPENROUTER_API_KEY=
PERPLEXITY_MODEL=perplexity/sonar
KNOWLEDGE_BRIDGE_STRATEGY=
KNOWLEDGE_BRIDGE_ENABLE_LOCAL_KB=false

# deployment hostname
HOST=

# Development postgres
POSTGRES_USER=deepfix-admin
POSTGRES_PASSWORD=deepfix-admin

# Production postgres
SUPABASE_PASSWORD=
SUPABASE_HOST=
SUPABASE_USER=

# Gmail SMTP Configuration
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=DeepFix

# Gmail SMTP settings (these are the defaults, but explicit is better)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_TLS=true

DEEPFIX_PORTAL_SERVICE_TOKEN=
DEEPFIX_PORTAL_SECRET_KEY=
DEEPFIX_PORTAL_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# === OpenHands OTEL Observability (MLflow Tracing) ===
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:5000
OTEL_EXPORTER_OTLP_HEADERS=x-mlflow-experiment-id=0
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf

# === S3 / RustFS Object Storage ===
AWS_ACCESS_KEY_ID=deepfix-admin
AWS_SECRET_ACCESS_KEY=deepfix-admin
AWS_ENDPOINT_URL=http://localhost:9000
AWS_DEFAULT_REGION=us-east-1
DEEPFIX_S3_BUCKET=deepfix-models

